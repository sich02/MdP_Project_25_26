<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.unicam.cs.mpgc.rpg122423.controller.DungeonController"
           fx:id="rootPane">
           
    <BorderPane style="-fx-background-color: #121212;">
        <!-- HUD in alto -->
        <top>
            <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #2b2b2b; -fx-border-color: #444; -fx-border-width: 0 0 2 0;">
                <Label fx:id="floorLabel" text="Piano: 1" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
                <HBox fx:id="heartsBox" spacing="5" alignment="CENTER_LEFT" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <Image url="/assets/coin.png"/>
                    </ImageView>
                    <Label fx:id="goldLabel" text="0" style="-fx-text-fill: gold; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <Image url="/assets/key.png"/>
                    </ImageView>
                    <Label fx:id="keysLabel" text="0" style="-fx-text-fill: silver; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
                </HBox>
            </HBox>
        </top>

        <!-- La Stanza al centro -->
        <center>
            <StackPane style="-fx-padding: 40;">
                <!-- Questo Pane è la stanza vera e propria. Ha dimensioni fisse per gestire bene le coordinate -->
                <Pane fx:id="roomPane" maxWidth="600" maxHeight="400"
                      style="-fx-background-color: #3e3e3e; -fx-border-color: #5c5c5c; -fx-border-width: 10;"/>
            </StackPane>
        </center>
    </BorderPane>

    <!-- Pause Menu Overlay -->
    <VBox fx:id="pauseMenuOverlay" alignment="CENTER" spacing="20" visible="false"
          style="-fx-background-color: rgba(0, 0, 0, 0.75);">
        <Label text="PAUSA" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
        <Button text="Continua" onAction="#handleContinue" prefWidth="200"
                style="-fx-font-size: 18px; -fx-background-color: #333; -fx-text-fill: white; -fx-border-color: #555; -fx-border-width: 2;"/>
        <Button text="Salva e torna al menu" onAction="#handleSaveAndQuit" prefWidth="300"
                style="-fx-font-size: 18px; -fx-background-color: #333; -fx-text-fill: white; -fx-border-color: #555; -fx-border-width: 2;"/>
    </VBox>
</StackPane>