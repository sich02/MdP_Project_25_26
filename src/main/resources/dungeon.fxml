<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.unicam.cs.mpgc.rpg122423.controller.DungeonController"
            style="-fx-background-color: #121212;">

    <!-- HUD in alto -->
    <top>
        <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #2b2b2b; -fx-border-color: #444; -fx-border-width: 0 0 2 0;">
            <Label fx:id="floorLabel" text="Piano: 1" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
            <Label fx:id="hpLabel" text="Cuori: 3.0/3.0" style="-fx-text-fill: #ff4c4c; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
            <Label fx:id="goldLabel" text="Oro: 0" style="-fx-text-fill: gold; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
            <Label fx:id="keysLabel" text="Chiavi: 0" style="-fx-text-fill: silver; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
        </HBox>
    </top>

    <!-- La Stanza al centro -->
    <center>
        <StackPane style="-fx-padding: 40;">
            <!-- Questo Pane è la stanza vera e propria. Ha dimensioni fisse per gestire bene le coordinate -->
            <Pane fx:id="roomPane" maxWidth="600" maxHeight="400"
                  style="-fx-background-color: #3e3e3e; -fx-border-color: #5c5c5c; -fx-border-width: 10;"/>
        </StackPane>
    </center>

    <!-- Controlli in basso -->
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #1e1e1e;">
            <Button text="Nord" prefWidth="80" onAction="#moveNorth"/>
            <Button text="Sud" prefWidth="80" onAction="#moveSouth"/>
            <Button text="Est" prefWidth="80" onAction="#moveEast"/>
            <Button text="Ovest" prefWidth="80" onAction="#moveWest"/>
        </HBox>
    </bottom>

</BorderPane>